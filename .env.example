# ------------------------------------------------------------------
# Bewehrungsrechner – Umgebungsvariablen
# Kopieren nach .env.local (lokal) bzw. in Vercel unter
# Settings → Environment Variables eintragen.
# ------------------------------------------------------------------

# --- Zahlung (Stripe) ---------------------------------------------

# Stripe-Geheimschlüssel (Testmodus: sk_test_…, Livemodus: sk_live_…)
# Solange diese Variable NICHT gesetzt ist, läuft die App im Demo-Modus
# (Dokumente ohne Zahlung – nur zum lokalen Testen!).
STRIPE_SECRET_KEY=

# Signaturgeheimnis des Webhooks (whsec_…), aus dem Stripe-Dashboard unter
# Entwickler → Webhooks. Ohne diesen Wert wird keine E-Mail versendet.
STRIPE_WEBHOOK_SECRET=

# Preis je Durchlauf in Cent (2900 = 29,00 €)
PREIS_CENT=2900

# Im Button angezeigter Preis (nur Anzeige)
NEXT_PUBLIC_PREIS_EUR=29

# --- E-Mail-Versand (Resend) --------------------------------------

# API-Schlüssel von https://resend.com (re_…).
# Fehlt er, funktioniert alles wie bisher – nur ohne E-Mail-Zustellung.
RESEND_API_KEY=

# Absenderadresse. Ohne eigene Domain zum Testen: onboarding@resend.dev
# Mit eigener Domain z. B.: Bewehrungsrechner <dokumente@ihre-domain.at>
MAIL_ABSENDER=

# --- Sonstiges -----------------------------------------------------

# Öffentliche Basis-URL (für Stripe-Rücksprung und die Links in der E-Mail).
# Lokal leer lassen (wird aus dem Request abgeleitet),
# in Produktion mit eigener Domain z. B. https://bewehrungsrechner.at
NEXT_PUBLIC_BASIS_URL=

# --- Betrieb und Fehlerbehandlung ---------------------------------

# Kontaktadresse, die Kundinnen und Kunden in Fehlermeldungen angezeigt wird
# (z. B. wenn nach der Zahlung etwas schiefgeht). Dringend setzen!
NEXT_PUBLIC_KONTAKT_MAIL=

# Notausgang: 1 schaltet den Demo-Modus AUCH in Produktion ein – dann werden
# Dokumente ohne Zahlung ausgegeben. Nur für Vorführungen, danach sofort
# wieder entfernen. Ohne diese Variable schlägt die App in Produktion hart
# fehl, wenn STRIPE_SECRET_KEY fehlt (statt still zu verschenken).
DEMO_MODUS=

# Code-Stand, der in den Dokumenten und in der Zahlungssession vermerkt wird.
# Auf Vercel wird stattdessen automatisch VERCEL_GIT_COMMIT_SHA verwendet;
# lokal kann hier z. B. "lokal" stehen.
APP_VERSION=
